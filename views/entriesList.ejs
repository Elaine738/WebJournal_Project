<!DOCTYPE html>
<html lang="en">
<head>
  <title>Web Journal</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.2/jquery.min.js"></script>
  <script type="text/javascript" src="manageEntry.js"></script>


</head>


<body>

    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
          <a class="navbar-brand">WebJournal</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/">Home</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/newJournal">Create New Journal!</a>
              </li>
            </ul>
            <ul class = "navbar-nav ms-auto">
              <li class="nav-item">
                <a class="nav-link" href="/register">Register</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/login">Login</a>
              </li>
            </ul>
          </div>
        </div>
    </nav>

    <h1>EntriesList page</h1>

    <div class="container">

      <div class="row align-items-start">
        <div class="col-2"></div>
        <div class="col-8" style="text-align: left;">
            <script>
                //calls the method in the manageJournal.js file to retrieve the users current Journals
                getJournals();
              </script>

              <!--Redirects the user upon clicking the journal to the entries page-->
              <a href = "/entry">
                <div id="EntriesList">
                </div>
            </a>
        <div class="col-2"></div>
      </div>
      <div id="EditEntry" style="display: none;">
        <form id="editEntryForm">
          <h4>Edit Entry</h4>
          <div class="mb-3">
            <label for="editEntryName" class="form-label">Title</label>
            <input type="text" class="form-control" id="editEntryName">
          </div>
          <button type="button" id="saveEdit" class="btn btn-success">Save Changes</button>
          <button type="button" id="cancelEdit" class="btn btn-secondary">Cancel</button>
        </form>
      </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
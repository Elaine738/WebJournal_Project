<!DOCTYPE html>
<html lang="en">
<head>
  <title>Web Journal</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <script>
    const userId = "<%= userId %>"; // declare the user ID to be used in javascript
    const username = "<%= username %>"; // declare the username to be used in html
    const journalId = "<%= journalId %>";
    </script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Audiowide">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.2/jquery.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playwrite+IT+Moderna:wght@100..400&display=swap" rel="stylesheet">
  <script type="text/javascript" src="/manageEntry.js"></script>
  <link rel="stylesheet" type="text/css" href="css/style.css" />


</head>


<body>

    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
          <a class="navbar-brand"><span style = "font-family:Playwrite IT Moderna, serif;">WebJournal</a></span>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/dashboard">Journals</a>
              </li>
            </ul>
            <ul class = "navbar-nav ms-auto">
              <li class="nav-item">
                <a class="nav-link" href="/logout">Logout</a>
              </li>
            </ul>
          </div>
        </div>
    </nav>

    <span style="color:rgb(55, 136, 187);font-weight:bold;font-size: 30px;font-family:Audiowide, sans-serif">
      <script>
        document.write("Hi, ", username, "!");
        </script>
      </span>

    <div class="container">

      <div class="row align-items-start">
        <div class="col-2"></div>
        <div class="col-8" style="text-align: left;">
          <div id="EntriesList">
            <script>
            getEntries();
            </script>
          </div>
        <div class="col-2"></div>
      </div>

      <!-- form for entering details to edit in existing entry - not visible unless button is clicked-->
      <div id="EditEntry" style="display: none;">
        <form id="editEntryForm">
          <h4>Edit Entry</h4>
          <div class="mb-3">
            <label for="editTitle" class="form-label">Title</label>
            <input type="text" class="form-control" id="editTitle">
          </div>

          <div class="mb-3">
            <label for="editBody" class="form-label">Body</label>
            <input type="text" class="form-control" id="editBody">
          </div>
          <button type="button" id="saveEdit" class="btn btn-success">Save Changes</button>
          <button type="button" id="cancelEdit" class="btn btn-secondary">Cancel</button>
        </form>
      </div>

      <!-- this is how individual entries are displayed upon user clicking button to view them-->
      <div id="ViewEntry" style="display: none;">
        <div id="EntryList" id="example1" ></div>
        <div class="mb-3">
          <h1 id="entryTitle"></h1>
          <p id="entryBody"></p>
          <img id="entryImage" src="entryImage" width="400"/>
        </div>
        <button type="button" id="cancelView" class="btn btn-secondary">Back</button>
      </div>

      <div id="add-entry-button">
        <button type="button" id="add-entry" class="block" style="display:block; width:40%;padding: 14px 28px; border:none; background-color: rgba(239, 186, 52, 0.648); font-size: medium;">Create New Entry!</button>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
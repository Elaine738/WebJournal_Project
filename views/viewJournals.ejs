        <script>
          async function sendMessageToQnA(question) {
            const endpoint = "https://webjournal-language.cognitiveservices.azure.com/language/:query-knowledgebases?projectName=knowledgebase-webjournal&api-version=2023-04-01";
            const subscriptionKey = "GCruOh7IFhSJfrPqEV3d9ZjoYVqSN7FnhbRmhCGMKG4FLqd9OVIuJQQJ99BDACYeBjFXJ3w3AAAaACOGzyvY"; 

            const response = await fetch(endpoint, {
                method: "POST",
                headers: {
                    "Ocp-Apim-Subscription-Key": subscriptionKey,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    "top": 1,
                    "question": question
                })
            });

            if (!response.ok) {
            throw new Error('HTTP Error! Status: ${response.status}');
            console.log('HTTP Error! Status: ${response.status}');
        }

            const data = await response.json();
            return data.answers[0]?.answer || "I don't have an answer for that.";
        }

        document.getElementById("send-button").addEventListener("click", async () => {
            const userInputField = document.getElementById("user-input");
            const userMessage = userInputField.value.trim();
            if (!userMessage) return;

            // Display User Message
            displayMessage(userMessage, "user-message");

            // Get Bot Response
            const botResponse = await sendMessageToQnA(userMessage);
            displayMessage(botResponse, "bot-message");

            // Clear Input
            userInputField.value = "";
        });

        function displayMessage(message, className) {
            const chatBox = document.getElementById("chat-box");
            const messageElement = document.createElement("div");
            messageElement.className = `message ${className}`;
            messageElement.textContent = message;
            chatBox.appendChild(messageElement);

            // Auto-scroll to latest message
            chatBox.scrollTop = chatBox.scrollHeight;
        }
            (async function () {
                const directLineToken = 'mG5Vd84s7hOp71qxxPcYCedqcqk5lKfxA7xyJupEFbAzSeA730WV'; // Replace with your Direct Line secret
    
                const webChatElement = document.getElementById('webchat');
    
                // Initialize Web Chat
                window.WebChat.renderWebChat({
                    directLine: window.WebChat.createDirectLine({
                        secret: directLineToken
                    }),
                    styleOptions: {
                        botAvatarInitials: 'Bot',
                        userAvatarInitials: 'You'
                    }
                }, webChatElement);
    
                // Focus on the input box
                webChatElement.querySelector('input').focus();
            })();
        </script>
        

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Web Journal</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <script>
    const userId = "<%= userId %>"; // declare the user ID to be used in javascript
    const username = "<%= username %>"; // declare the username to be used in html
    </script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Audiowide">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.2/jquery.min.js"></script>

  <!-- importing font from for WebJournal logo from Google fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playwrite+IT+Moderna:wght@100..400&display=swap" rel="stylesheet">
  <script type="text/javascript" src="/manageJournal.js"></script>
  <link rel="stylesheet" type="text/css" href="/css/style.css" />

  <!-- script src for chatbot-->
  <script src="https://cdn.botframework.com/botframework-webchat/latest/webchat.js"></script>
</head>


<body>

    <nav class="navbar navbar-inverse navbar-expand-lg bg-light p-3 mb-2 bg-secondary text-white">
        <div class="container-fluid">
          <a id="logo" class="navbar-brand">WebJournal</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link active" href="/Dashboard">Dashboard</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/newJournal">Create New Journal!</a>
              </li>
            </ul>
            <ul class = "navbar-nav ms-auto">
              <li class="nav-item">
                <a class="nav-link" href="/account">Account</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/logout">Logout</a>
              </li>
            </ul>
          </div>
        </div>
    </nav>

    <span style="color:rgb(55, 136, 187);font-weight:bold;font-size: 30px;font-family:Audiowide, sans-serif">
    <script>
      document.write("Hi, ", username, "!");
      </script>
    </span>

    <div class="container">

      <div class="row align-items-start">
        <div class="col-2"></div>
        <div id="journalStyle" class="col-6" style="text-align: center; align-items: center;">
          <script>
            //calls the method in the manageJournal.js file to retrieve the users current Journals
            getJournals();
          </script>
          <!-- Calls div that has stored the journals to be displayed-->
          <div id="JournalList"></div>

          <div id="chatContainer">
            <div id="chatHeader">Chat with Our Bot</div>
            <div id="webchat" style="padding:10px; overflow-y:auto; flex:1;"></div>
            <input type="text" id="userInput" placeholder="Type your question..." style="border:none; border-top:1px solid #ccc; padding:10px; width:100%;">
          </div>
      
      </div>
      <div id="EditJournal" style="display: none;">
        <form id="editJournalForm">
          <h4>Edit Journal</h4>
          <div class="mb-3">
            <label for="editJournalName" class="form-label">Title</label>
            <input type="text" class="form-control" id="editJournalName">
          </div>
          <div class="mb-3">
            <label for="editJournalImage" class="form-label">Cover Image:</label>
            <input type="file" class="form-control" id="editJournalImage">
          </div>
          <button type="button" id="saveEdit" class="btn btn-success">Save Changes</button>
          <button type="button" id="cancelEdit" class="btn btn-secondary">Cancel</button>
        </form>
      </div>
  
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
<script type="text/javascript" src="/chatbox.js"></script>
</html>


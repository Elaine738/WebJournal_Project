<!DOCTYPE html>
<html lang="en" ng-app="Dashboard">
  <head>
    <title>Web Journal</title>    
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
      const journalId = "<%= journalId %>";
      const userId = "<%= userId %>";
      </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.2/jquery.min.js"></script>

    <link href="https://fonts.googleapis.com/css2?family=Playwrite+IT+Moderna:wght@100..400&display=swap" rel="stylesheet">
    <script type="text/javascript" src="/manageEntry.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/style.css" />
  
  </head>
  
  <body>

    <nav class="navbar navbar-inverse navbar-expand-lg bg-light p-3 mb-2 bg-secondary text-white">
      <div class="container-fluid">
        <a id="logo" class="navbar-brand">WebJournal</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/Dashboard">Dashboard</a>
            </li>
          </ul>
          <ul class = "navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link active" href="/account">Account</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li>
          </ul>
        </div>
      </div>
  </nav>

    <div class="container">

      <!-- New Entry Box -->
      <div class="row align-items-start">
        <div class="col-2"></div>
        <div class="col-8" style="text-align: left; border-bottom: 1px solid #222222;">
          <form style="font-size: 10pt;" id="newEntryForm">
            <div class="mb-3">
              <label for="title" class="form-label">Title</label>
              <input type="text" class="form-control" id="title">
            </div>
            <div class="mb-3">
                <label for="body" class="form-label">Body</label>
                <textarea input type="text" id="body" class="form-control" name="body" rows="9" cols="50"></textarea>
              </div>
            <div class="mb-3">
              <label for="fileInput" class="form-label">Add Image:</label>
              <input type="file" class="form-control" id="imageInput" accept="image/*">
              <!-- the 'accept' function will only show users valid files when going to upload an image but this is easily worked around-->
              <div id="previewContainer"></div>
              <script>
              const imageInput = document.getElementById('imageInput');
              const previewContainer = document.getElementById('previewContainer');
              
              function previewSelectedImages() {
                previewContainer.innerHTML = '';
                const files = imageInput.files;
                
                if (!files.length) return;
                
                for (let i = 0; i < files.length; i++) {
                  const reader = new FileReader();
                  
                  reader.onload = function (e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.width = '170px';
                    img.style.margin = '5px';
                    img.style.borderRadius = '5px';
                    
                    previewContainer.appendChild(img);
                  };
                  reader.readAsDataURL(files[i]);
                }
              }
              imageInput.addEventListener('change', previewSelectedImages);  
             </script>
            </div>

            <div class="mb-3">
              <label for="fileInput" class="form-label">Add Video:</label>
              <input type="file" class="form-control" id="videoInput" accept="video/*">
            </div>

            <div class="mb-3">
              <label for="fileInput" class="form-label">Add Audio:</label>
              <input type="file" class="form-control" id="audioInput" accept="audio/*">
            </div>

            <button type="button" id="subNewEntry" class="btn btn-primary">Save</button> <br/><br/>
          </form>
        </div>
        <div class="col-2"></div>
      </div>

    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Web Journal</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <script>
    const userId = "<%= userId %>"; // declare the user ID to be used in javascript
    const username = "<%= username %>"; // declare the username to be used in html
  </script>
    
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.2/jquery.min.js"></script>

  <link href="https://fonts.googleapis.com/css2?family=Playwrite+IT+Moderna:wght@100..400&display=swap" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="/css/style.css" />

  <script type="text/javascript" src ="/userManager.js"></script>

</head>


<body>

  <nav class="navbar navbar-inverse navbar-expand-lg bg-light p-3 mb-2 bg-secondary text-white">
    <div class="container-fluid">
      <a id="logo" class="navbar-brand">WebJournal</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/Dashboard">Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/newJournal">Create New Journal!</a>
          </li>
        </ul>
        <ul class = "navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link active" href="/account">Account</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>
        </ul>
      </div>
    </div>
</nav>
      
      <span style="color:rgb(55, 136, 187);font-weight:bold;font-size: 30px;font-family:Audiowide, sans-serif">
        <script>
          document.write("Hi, ", username, "!");
          </script>
      </span>
      
      <div class="box" id="options">
            <div class="item">
              <button class='btn btn-outline-secondary edit-button' style='margin-top: 10px;'>Change Password</button> <br/>
              <button class='btn btn-danger' id="deleteAccount" style='margin-top: 10px;'>Delete Account</button> <br/>
            </div>
      </div>

      <div id="passwordChange" style="display: none;">
        <form id="passwordForm">
          <h4>Change Your Password:</h4>
          <div class="mb-3">
            <label for="newPassword" class="form-label">New Password: </label>
            <input type="text" class="form-control" id="newPassword" required>
          </div>
          <button type="submit" id="savePassword" class="btn btn-success">Save Password</button>
        </form>
          <button type="button" id="cancelEdit" class="btn btn-secondary">Cancel</button>
      </div>
      
      <script>
      $(".edit-button").on("click", function() {
        $("#passwordChange").show(); 
        $("#options").hide(); 
    
        });
    
      $("#cancelEdit").on("click", function() {
        //$("#passwordChange").hide(); 
        $("#options").show(); 
        });
      </script>

        
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>

